    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.0",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "lucide": "1.47.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/react": "4.0.110",
    "ai": "7.0.107",
    "dompurify": "3.4.17",
