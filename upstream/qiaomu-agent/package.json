{
  "name": "qiaomu-agent",
  "version": "0.6.7",
  "description": "A calm, native AI agent sidebar for Obsidian.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/test-update-notes.mjs && tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:update-notes": "node scripts/test-update-notes.mjs"
  },
  "keywords": [
    "obsidian",
    "ai",
    "agent",
    "mcp",
    "skills"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.0",
    "happy-dom": "20.14.5",
    "obsidian": "^1.13.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/react": "4.0.110",
    "ai": "7.0.107",
    "lucide-react": "1.47.0",
    "pele": "1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "use-stick-to-bottom": "1.1.6"
  },
  "overrides": {
    "zod": "4.6.6",
    "undici": "7.30.1"
  }
}
